meta {
  name: Update (PATCH)
  type: http
  seq: 6
}

patch {
  url: {{base_url}}/api/users/2
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "job": "lecturer"
  }
}

tests {
  test("status 200", () => expect(res.getStatus()).to.equal(200));
  test("job echoed", () => expect(res.getBody().job).to.equal("lecturer"));
}
