meta {
  name: Avatar image served locally
  type: http
  seq: 18
}

get {
  url: {{base_url}}/img/faces/2-image.jpg
  body: none
  auth: none
}

tests {
  test("status 200", () => expect(res.getStatus()).to.equal(200));
  test("jpeg", () => expect(res.headers["content-type"]).to.equal("image/jpeg"));
}
