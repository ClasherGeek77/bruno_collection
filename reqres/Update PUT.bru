meta {
  name: Update (PUT)
  type: http
  seq: 5
}

put {
  url: {{base_url}}/api/users/2
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "janet",
    "job": "leader"
  }
}

tests {
  test("status 200", () => expect(res.getStatus()).to.equal(200));
  test("updatedAt", () => expect(res.getBody().updatedAt).to.be.a("string"));
}
